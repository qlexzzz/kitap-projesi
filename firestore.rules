rules_version = '2';

/* Kitap Odası — Firestore kuralları
   Yükleme: firebase deploy --only firestore:rules
   (veya konsoldan Firestore > Kurallar bölümüne yapıştırın) */

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    /* ── kullanıcı profilleri ──
       Herkes okur (sıralamada ad görünür), yalnızca sahibi düzenler. */
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSelf(uid)
        && request.resource.data.firstName is string
        && request.resource.data.lastName is string
        && request.resource.data.grade is string;
      allow update: if isSelf(uid);
      allow delete: if false;
    }

    /* ── kitap yorumları ──
       Tek kullanıcı + tek kitap = tek yorum (belge id'si: bookId__uid) */
    match /bookReviews/{reviewId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 500;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    /* ── okuma sonuçları ──
       Tamamen kişisel: başkasının verisini görmek mümkün değil.
       Sıralama, users.totalTests sayaçları üzerinden kurulur. */
    match /readingResults/{resultId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.wpm is int
        && request.resource.data.wpm >= 0
        && request.resource.data.score <= request.resource.data.total;
      allow update, delete: if false;
    }

    /* varsayılan: her şey kapalı */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
